foff="${HOME}/fofo"; 
##
seq 12 > ${foff}/ff.log; 
##
while [ "$(cat ${foff}/ff.log | wc --lines)" -gt "4" ]; do fortune > ${foff}/ff.log; done; 
##
fofo=($(cat ${foff}/ff.log)); 
